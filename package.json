{
	"name": "pi-workspace",
	"private": true,
	"license": "MIT",
	"type": "module",
	"packageManager": "bun@1.4.1",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "bun run --workspaces --sequential build",
		"check": "biome check --error-on-warnings .",
		"check:fix": "biome check --write --error-on-warnings",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit && bun run --workspaces --sequential typecheck",
		"test": "bun test ./tests && bun run --workspaces --sequential test",
		"hooks:install": "lefthook install"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/bun": "1.4.2",
		"lefthook": "2.1.16",
		"rolldown": "1.2.12",
		"typescript": "7.0.2"
	}
}
