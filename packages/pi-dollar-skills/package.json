{
	"name": "@wangjq4214/pi-dollar-skills",
	"version": "0.1.0",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wangjq4214/pi-delegate.git",
		"directory": "packages/pi-dollar-skills"
	},
	"description": "Codex-style $skill selection and full instruction injection for Pi.",
	"license": "MIT",
	"type": "module",
	"packageManager": "bun@1.4.1",
	"engines": {
		"node": ">=22.19.0"
	},
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"skills"
	],
	"files": [
		"dist",
		"README.md",
		"README.zh-CN.md"
	],
	"scripts": {
		"build": "rolldown -c",
		"build:watch": "rolldown -c --watch",
		"prepack": "bun run build",
		"dev": "pi -e ./src/index.ts",
		"start": "pi -e ./dist/index.js",
		"typecheck": "tsc --noEmit",
		"test": "bun test ./tests"
	},
	"pi": {
		"extensions": [
			"./dist/index.js"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-tui": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"@earendil-works/pi-ai": {
			"optional": true
		},
		"@earendil-works/pi-tui": {
			"optional": true
		}
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-tui": "1.4.0"
	}
}
